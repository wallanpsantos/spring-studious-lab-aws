# Copie para .env se quiser sobrescrever os padrões locais.
# O .env não entra no Git.

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Host (IDE). O Compose troca isso para http://localstack:4566 dentro da rede.
AWS_ENDPOINT=http://localhost:4566

# Credenciais só do Mongo local. Não reutilize fora da máquina.
MY_MONGO_INITDB_ROOT_USERNAME=root
MY_MONGO_INITDB_ROOT_PASSWORD=qwe123
MY_MONGO_PORT=27017

# Host (IDE). O Compose aponta o serviço para mongo-dev:27017.
MONGODB_URI=mongodb://root:qwe123@localhost:27017/spring-studious-lab-aws-database?authSource=admin

SQS_QUEUE_PARTIAL=payment-partial-queue
SQS_QUEUE_TOTAL=payment-total-queue
SQS_QUEUE_OVERMEASURE=payment-overmeasure-queue
SNS_TOPIC_NAME=payments-topic
S3_BUCKET_NAME=bucket-studios-lab-aws

# Obrigatório só se a imagem do LocalStack for a linha unificada (2026.3+ / latest).
# Plano Hobby, uso não comercial: https://app.localstack.cloud
# LOCALSTACK_AUTH_TOKEN=
